# ── ArticulAIT Configuration Example ───────────────────────────
# Database (SQLite, zero-install)
DATABASE_URL=sqlite:///./data/articulait.db

# COLMAP Binary Path
COLMAP_PATH=d:/articulait/colmap_bin/COLMAP-3.9.1-windows-cuda/COLMAP.bat

# Data & Model Directories
DATA_DIR=d:/articulait/data
MODELS_DIR=d:/articulait/models

# ── AI Models ─────────────────────────────────────────────────
VGGT_MODEL=facebook/VGGT-1B-Commercial
HF_TOKEN=your_huggingface_token_here

# ── 3DGS Training ────────────────────────────────────────────
GSPLAT_MAX_STEPS=7000
GSPLAT_SH_DEGREE=2

# ── Upload Limits ─────────────────────────────────────────────
MAX_UPLOAD_IMAGES=500

# ── Server ────────────────────────────────────────────────────
CORS_ORIGINS=*
LUMA_API_KEY=your_luma_api_key_here
RECONSTRUCTION_MODE=local
GENERATE_SCENE_MESH=true
